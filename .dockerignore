project/backend/storage/app/private/*
project/backend/storage/framework/cache/data/*
project/backend/storage/framework/sessions/*
project/backend/storage/framework/testing/*
project/backend/storage/framework/views/*
project/backend/storage/logs/*

project/frontend/node_modules
project/frontend/.angular
project/frontend/dist
