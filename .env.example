# Used by docker compose (copy to .env to override)
# Limited DB user that Laravel connects with
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret
# Postgres superuser "postgres", admin tasks only
DB_ROOT_PASSWORD=root_secret
UID=1000
GID=1000
BACKEND_PORT=8001
FRONTEND_PORT=4200
DB_PORT=5432
# Optional pgAdmin (docker compose --profile tools up -d)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
